{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}
