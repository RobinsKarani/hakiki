# Copy to .env yourself. The real .env is ignored; do not publish it.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional local server configuration. The browser can select endpoint and model.
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# Explicitly choose one provider/model per run. No provider fallback.
REVIEW_PROVIDER=groq
REVIEW_MODEL=openai/gpt-oss-120b
# Existing public KenyaLaw checkout with dependencies installed.
# Use the built dist/src/index.js entry for Node, not private product code.
KENYALAW_MCP_ENTRY=
