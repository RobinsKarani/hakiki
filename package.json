{
  "name": "procurement-review-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "bun test tests",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "tsc -p tsconfig.build.json && vite build web",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build",
    "test:legal": "node --env-file-if-exists=.env --experimental-strip-types scripts/legal-smoke.ts",
    "review": "node --env-file-if-exists=.env --experimental-strip-types src/cli.ts",
    "audit": "bun audit",
    "test:filesystem": "node --experimental-strip-types scripts/filesystem-smoke.ts",
    "eval:paid": "node --env-file-if-exists=.env --experimental-strip-types src/cli.ts sample --send-to-provider",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "bun install --frozen-lockfile --ignore-scripts && bun run build && bun run start",
    "setup": "bun run scripts/setup.ts",
    "launch": "bun run setup && bun run start",
    "test:browser": "node --experimental-strip-types scripts/browser-smoke.ts",
    "diagram": "node --experimental-strip-types scripts/diagram.ts",
    "eval:open-weights": "node --env-file-if-exists=.env --experimental-strip-types scripts/open-weight-review.ts",
    "demo:live": "node --env-file-if-exists=.env --experimental-strip-types scripts/demo-live.ts",
    "eval:recorded": "node --experimental-strip-types scripts/evaluate-run.ts",
    "eval:suite": "node --env-file-if-exists=.env --experimental-strip-types scripts/evaluate-suite.ts"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/server-filesystem": "1.0.0",
    "openai": "7.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "1.8.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
